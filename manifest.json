{
  "manifest_version": 3,
  "name": "UX Doctor",
  "version": "1.0.0",
  "description": "Analyze web pages for UX/accessibility flaws with deterministic and heuristic evaluation",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
 ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/deterministic.js", "scripts/llm_evaluator.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
